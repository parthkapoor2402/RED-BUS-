{
  "name": "departing-soon-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:phase1": "vitest run src/policy.phase1.test.ts",
    "test:phase2": "vitest run src/policy.phase2.test.ts",
    "test:phase3": "vitest run src/policy.phase3.test.ts",
    "test:phase4": "vitest run src/App.phase4.test.tsx",
    "test:phase5": "vitest run src/App.phase5.test.tsx",
    "test:phases": "vitest run src/policy.phase1.test.ts && vitest run src/policy.phase2.test.ts && vitest run src/policy.phase3.test.ts && vitest run src/App.phase4.test.tsx && vitest run src/App.phase5.test.tsx"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
